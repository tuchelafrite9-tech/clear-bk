{
  "name": "Client",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "title": "Nom"
    },
    "prenom": {
      "type": "string",
      "title": "Pr\u00e9nom"
    },
    "mail": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "iban": {
      "type": "string",
      "title": "IBAN"
    },
    "numero_de_compte": {
      "type": "string",
      "title": "Num\u00e9ro de compte"
    },
    "numero_de_compte_sequestre": {
      "type": "string",
      "title": "Num\u00e9ro de compte s\u00e9questre"
    },
    "reference_dossier_sequestre": {
      "type": "string",
      "title": "R\u00e9f\u00e9rence du dossier s\u00e9questre"
    },
    "date_liberation_comite_sequestre": {
      "type": "string",
      "title": "Date de lib\u00e9ration du comit\u00e9 s\u00e9questre",
      "format": "date"
    },
    "remarque": {
      "type": "string",
      "title": "Remarque"
    },
    "contrat_pdf": {
      "type": "string",
      "title": "Contrat PDF",
      "format": "uri"
    },
    "derniere_connexion": {
      "type": "string",
      "title": "Derni\u00e8re connexion",
      "format": "date-time"
    },
    "signature_acceptee": {
      "type": "boolean",
      "title": "Convention sign\u00e9e",
      "default": false
    },
    "date_signature": {
      "type": "string",
      "title": "Date de signature",
      "format": "date-time"
    },
    "documents_client": {
      "type": "array",
      "title": "Documents client",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "compte_valide": {
      "type": "boolean",
      "title": "Compte valid\u00e9 par l'administrateur",
      "default": false
    }
  },
  "required": [
    "nom",
    "prenom",
    "mail"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.mail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.mail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}